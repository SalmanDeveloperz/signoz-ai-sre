# Port control-plane listens on
PORT=4001

# Postgres connection string used by src/db.js
DATABASE_URL=postgres://hackathon:hackathon@app-postgres:5432/hackathon

# Service name reported to SigNoz via OpenTelemetry
OTEL_SERVICE_NAME=control-plane

# SigNoz OTLP collector endpoint that traces are exported to
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318/v1/traces
