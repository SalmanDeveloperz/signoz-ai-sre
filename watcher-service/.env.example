# Port watcher-service listens on
PORT=4002

# control-plane base URL: watcher reads/writes settings and posts incidents here
CONTROL_PLANE_URL=http://control-plane:4001

# SigNoz query API base URL: watcher asks "what just happened" after an alert.
# NOTE: the container's actual network alias is signoz-signoz-0, not "signoz"
# (found by inspecting the signoz-network Docker network directly). The wrong
# host here fails silently: Tier 2 just gets empty query results.
SIGNOZ_URL=http://signoz-signoz-0:8080

# SigNoz Service Account API key, used by signozClient.js (Tier 2's read-only
# telemetry queries). Generate one at Settings -> Service Accounts -> New
# Service Account -> Keys -> Add Key, and assign it the "signoz-viewer" role
# (Overview tab -> Roles -> signoz-viewer -> Save Changes). Viewer is enough,
# this client never writes anything. Leave blank to skip Tier 2 entirely,
# unrecognized alerts then just log "no automated fix" and take no action.
SIGNOZ_API_KEY=

# Anthropic API key, used by llmClient.js for Tier 2's investigation agent.
# Get one at https://console.anthropic.com. Leave blank to skip Tier 2
# entirely (same safe fallback as above).
ANTHROPIC_API_KEY=

# Which Claude model Tier 2 uses. Override if this default isn't available
# on your account.
ANTHROPIC_MODEL=claude-sonnet-5

# Service name reported to SigNoz via OpenTelemetry
OTEL_SERVICE_NAME=watcher-service

# SigNoz OTLP collector endpoint that traces are exported to.
# NOTE: the collector is reachable on signoz-network as `signoz-ingester`,
# NOT `signoz-otel-collector`. Wrong host = telemetry silently vanishes.
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-ingester:4318/v1/traces
