# Port watcher-service listens on
PORT=4002

# control-plane base URL — watcher reads/writes settings and posts incidents here
CONTROL_PLANE_URL=http://control-plane:4001

# SigNoz query API base URL — watcher asks "what just happened" after an alert
SIGNOZ_URL=http://signoz:8080

# Service name reported to SigNoz via OpenTelemetry
OTEL_SERVICE_NAME=watcher-service

# SigNoz OTLP collector endpoint that traces are exported to.
# NOTE: the collector is reachable on signoz-network as `signoz-ingester`,
# NOT `signoz-otel-collector`. Wrong host = telemetry silently vanishes.
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-ingester:4318/v1/traces
